# Database (SQLite local, PostgreSQL production)
DATABASE_URL=sqlite:///./data/pharma_alerts.db

# API key for mutating endpoints (X-API-Key header).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = mutating endpoints disabled.
API_KEY=change-me-to-a-random-secret

# Error tracking (Sentry). Empty = disabled.
# https://sentry.io → Create project → Python (FastAPI) → copy the DSN.
SENTRY_DSN=

# ── Notifications (optional for development) ──
# Telegram: create a bot via @BotFather, get token, find your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: legacy single webhook (fallback)
DISCORD_WEBHOOK_URL=

# Discord channel-specific webhooks (set at least one for alerts)
DISCORD_WEBHOOK_HIGH_IMPACT=   # PDUFA, Phase 3 — @everyone ping
DISCORD_WEBHOOK_SEC_LIVE=      # SEC filings (8-K, 13D, S-1) in real-time
DISCORD_WEBHOOK_BRIEFING=      # Daily morning radar + evening wrap
DISCORD_WEBHOOK_CLINICAL=      # CT.gov status/phase changes
DISCORD_WEBHOOK_NEWS=           # Pharma news feed (FierceBio, BioSpace, GNW)

# App config
ALERT_DAYS_BEFORE=7
REFRESH_INTERVAL_HOURS=6
BASE_URL=http://localhost:8000
TIMEZONE=America/New_York     # Market timezone for daily briefings
